# ==============================================================================
# MyAgent - Company Data AI Agent Environment Configuration
# Target Server: 192.168.9.9 | Web Port: 3399
# ==============================================================================

# Server Web & API Ports
WEB_PORT=3399
BACKEND_PORT=8000

# Security & Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Aa987654
JWT_SECRET=company-secret-jwt-token-key-3399-2026
JWT_EXPIRATION_HOURS=72

# External LLM Server Configuration (Ollama, vLLM, LM Studio, OpenAI-compatible)
# Example for Ollama: http://192.168.9.x:11434/v1
# Example for vLLM:   http://192.168.9.x:8000/v1
# Example for OpenAI: https://api.openai.com/v1
LLM_BASE_URL=http://192.168.9.10:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=llama3.3

# Agent Configuration
AGENT_NAME="Company Data Intelligence Agent"
AGENT_TEMPERATURE=0.3
MAX_CONTEXT_TOKENS=8192

# Memory & RAG Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNKING_SIZE=800
CHUNKING_OVERLAP=150
TOP_K_RESULTS=4

# Persistent Storage Paths inside Container
DATA_DIR=/app/data
DOCUMENTS_DIR=/app/data/documents
CHROMA_DIR=/app/data/chroma_db
